# Nebula Home — exemplo de configuração (PoC local).
# Copie para `.env` (backend) conforme precisar. Nada aqui é versionado.
# O frontend lê apenas variáveis NEXT_PUBLIC_* via `.env.local`.

# --- backend (tuya_dash.py / tuya_mobile.py) ---
# Porta/bind da API local. Mantenha 127.0.0.1 para não expor sua LAN.
NEBULA_HOST=127.0.0.1
NEBULA_API_PORT=8765
NEBULA_URL=http://127.0.0.1:3100/
TUYA_RTSP_URL=rtsp://127.0.0.1:8554
TUYA_REGION=us-west
TUYA_COUNTRY=55
TUYA_TIMEZONE=UTC

# Identidade do app Tuya Smart (engenharia reversa, sem afiliação).
# Os defaults no código já funcionam; defina aqui só se a Tuya rotacionar.
# TUYA_PACKAGE=com.tuya.smart
# TUYA_CLIENT_ID=
# TUYA_APP_KEY=
# TUYA_APP_SECRET=
# TUYA_CERT_SHA256=
# TUYA_DEVICE_ID=

# --- frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8765
